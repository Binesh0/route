<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypeName="packageFormat"?>
<package format="3">
  <name>amr_fleet_adapter</name>
  <version>0.1.0</version>
  <description>AMR Fleet Adapter for TurtleBot with Delivery Capabilities using RMF and Nav2</description>
  <maintainer email="your.email@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>

  <!-- RMF dependencies -->
  <depend>rmf_fleet_adapter_python</depend>
  <depend>rmf_fleet_adapter</depend>
  <depend>rmf_traffic</depend>
  <depend>rmf_traffic_ros2</depend>
  <depend>rmf_utils</depend>
  <depend>rmf_robot_sim_common</depend>
  <depend>rmf_task_msgs</depend>
  <depend>rmf_fleet_msgs</depend>

  <!-- ROS2 Python dependencies -->
  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Navigation dependencies -->
  <depend>nav2_msgs</depend>
  <depend>nav2_simple_commander</depend>

  <!-- Custom delivery message types -->
  <depend>builtin_interfaces</depend>
  <depend>action_msgs</depend>

  <!-- Python dependencies -->
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>