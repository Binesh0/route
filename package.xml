<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypeName="packageFormat"?>
<package format="3">
  <name>amr_fleet_adapter</name>
  <version>0.1.0</version>
  <description>AMR Fleet Adapter for TurtleBot using RMF and Nav2</description>
  <maintainer email="your.email@example.com">Your Name</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- RMF dependencies -->
  <depend>rmf_fleet_adapter</depend>
  <depend>rmf_traffic</depend>
  <depend>rmf_traffic_ros2</depend>
  <depend>rmf_utils</depend>
  <depend>rmf_robot_sim_common</depend>

  <!-- ROS2 dependencies -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Navigation dependencies -->
  <depend>nav2_msgs</depend>
  <depend>nav2_util</depend>
  <depend>nav2_costmap_2d</depend>

  <!-- JSON and YAML handling -->
  <depend>nlohmann-json-dev</depend>
  <depend>yaml-cpp</depend>
  <depend>libopencv-dev</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>